<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoseTrap.ViewModels"
        x:Class="RoseTrap.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RoseTrap"
        Icon="/Assets/rosetrap.ico"
        Width="1080" Height="690" MinWidth="760" MinHeight="520"
        Background="{DynamicResource Shell}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- One nav entry: a 18px filled icon in a fixed 40px column so it never shifts while the rail expands. -->
    <Style Selector="Button.nav">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="Transparent" CornerRadius="8" Height="38">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="40,*">
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{TemplateBinding Tag, Converter={x:Static vm:IconConverter.Instance}}" Fill="{DynamicResource AccentBright}" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Classes="navlabel" Text="{TemplateBinding Content}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="#262428" />
    </Style>
    <Style Selector="Button.nav.active /template/ Border#bg">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav TextBlock.navlabel">
      <Setter Property="Foreground" Value="#b8b1b5" />
    </Style>
    <Style Selector="Button.nav.active TextBlock.navlabel, Button.nav:pointerover TextBlock.navlabel">
      <Setter Property="Foreground" Value="#f2e9ed" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="42,*">
    <!-- Title bar -->
    <Border Name="TitleBar" Background="{DynamicResource TitleBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
        <Button Name="BrandHome" Background="Transparent" BorderThickness="0" Padding="0" Height="NaN" ToolTip.Tip="Home">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Image Source="{StaticResource AppIcon}" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock FontSize="14" FontWeight="SemiBold" LetterSpacing="-0.3" VerticalAlignment="Center">
              <Run Text="Rose" Foreground="#f0e9ec" /><Run Text="Trap" Foreground="{DynamicResource Accent}" />
            </TextBlock>
          </StackPanel>
        </Button>
        <TextBlock Name="Crumb" Margin="12,1,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- Pages live side by side in this panel; only the current one is visible. Left margin = collapsed rail. -->
      <Panel Name="PageHost" Margin="58,0,0,0" Background="{DynamicResource ContentBg}" ClipToBounds="True" />

      <!-- Sidebar rail: icons only, opens over the page while hovered. -->
      <Border Name="Sidebar" Width="58" HorizontalAlignment="Left" ZIndex="10"
              Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
              Padding="9,14,9,12" ClipToBounds="True" BoxShadow="0 0 0 0 #00000000">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="{StaticResource EaseOut}" />
            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
          </Transitions>
        </Border.Transitions>
        <Panel Name="NavPanel">
          <Border Name="NavIndicator" Height="38" VerticalAlignment="Top" CornerRadius="8" Opacity="0"
                  Background="#2e282b" RenderTransform="none">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource EaseOut}" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <Border Width="3" Margin="0,10" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBright}" />
          </Border>

          <DockPanel>
            <StackPanel Name="NavBottom" DockPanel.Dock="Bottom" Spacing="4">
              <Button Classes="nav" Tag="Settings" Content="Settings" />
              <Button Classes="nav" Tag="Appearance" Content="Appearance" />
            </StackPanel>
            <StackPanel Name="NavTop" Spacing="4">
              <Button Classes="nav" Tag="General" Content="General" />
              <Button Classes="nav" Tag="Global" Content="Global" />
              <Button Classes="nav" Tag="FFlags" Content="Fast flags" />
              <Button Classes="nav" Tag="FFlags Settings" Content="Flag settings" />
              <Button Classes="nav" Tag="Preset" Content="Presets" />
              <Button Classes="nav" Tag="Shaders" Content="Shaders" />
            </StackPanel>
          </DockPanel>
        </Panel>
      </Border>

      <StackPanel Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Spacing="8"
                  ZIndex="20" IsHitTestVisible="False" />
    </Grid>
  </Grid>
</Window>
