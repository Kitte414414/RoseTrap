<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoseTrap.ViewModels"
        xmlns:c="using:RoseTrap.Controls"
        x:Class="RoseTrap.Views.LoadingWindow"
        x:DataType="vm:LoadingSession"
        Title="RoseTrap · Loading"
        Icon="/Assets/rosetrap.ico"
        Width="720" Height="405" CanResize="False"
        SystemDecorations="None" Topmost="True" ShowInTaskbar="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="#4a3f44" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#7d7277" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Name="Card" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource Shell}"
          BorderBrush="#3a3035" BorderThickness="1">
    <Border.Transitions>
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.35" /></Transitions>
    </Border.Transitions>
    <Panel>
      <!-- Game picture, faded into the card from the left so the text stays readable. -->
      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.75" />
      <c:LogoRose Width="330" Height="300" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                  IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
      <Ellipse Width="520" Height="420" Margin="-140,-120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#30a64f68" />
            <GradientStop Offset="1" Color="#00000000" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Border IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#f0141113" />
            <GradientStop Offset="0.55" Color="#b0141113" />
            <GradientStop Offset="1" Color="#40141113" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="190">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00141113" />
            <GradientStop Offset="1" Color="#f2141113" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="28,22,28,24">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="{StaticResource AppIcon}" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock FontSize="14" FontWeight="SemiBold" LetterSpacing="-0.3" VerticalAlignment="Center">
              <Run Text="Rose" Foreground="#f0e9ec" /><Run Text="Trap" Foreground="{DynamicResource Accent}" />
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="2" Name="HideButton" Classes="icon" ToolTip.Tip="Hide loading screen" VerticalAlignment="Center">
            <Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Close}" Fill="#b8b1b5" /></Canvas></Viewbox>
          </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,18">
          <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True" Margin="0,0,16,0" Background="#2a2226"
                  BorderBrush="#40ffffff" BorderThickness="1" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Name="GameTitle" Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" Foreground="#f6eef1"
                       TextTrimming="CharacterEllipsis" LetterSpacing="-0.4" />
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#b9adb3" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LoadingStep">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Classes="dot" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}" />
                <TextBlock Classes="step" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}" Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.Styles>
            <Style Selector="Ellipse.dot.done"><Setter Property="Fill" Value="{DynamicResource Accent}" /></Style>
            <Style Selector="Ellipse.dot.active"><Setter Property="Fill" Value="{DynamicResource AccentBright}" /></Style>
            <Style Selector="TextBlock.step.done"><Setter Property="Foreground" Value="#a99da3" /></Style>
            <Style Selector="TextBlock.step.active"><Setter Property="Foreground" Value="#f2e9ed" /></Style>
          </ItemsControl.Styles>
        </ItemsControl>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
          <ProgressBar Name="Bar" Classes="launch" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center">
            <ProgressBar.Transitions>
              <Transitions><DoubleTransition Property="Value" Duration="0:0:0.45" /></Transitions>
            </ProgressBar.Transitions>
          </ProgressBar>
          <TextBlock Grid.Column="1" Name="StatusText" Text="{Binding Status}" Margin="14,0,0,0" MinWidth="120" TextAlignment="Right"
                     FontSize="12" Foreground="#c9bec3" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Panel>
  </Border>
</Window>
