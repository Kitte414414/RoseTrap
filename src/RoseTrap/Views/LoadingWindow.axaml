<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoseTrap.ViewModels"
        xmlns:c="using:RoseTrap.Controls"
        x:Class="RoseTrap.Views.LoadingWindow"
        x:DataType="vm:LoadingSession"
        Title="RoseTrap · Loading"
        Icon="/Assets/rosetrap.ico"
        Width="400" Height="292" CanResize="False"
        SystemDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.small">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="#29282b" />
      <Setter Property="Foreground" Value="#ece5e8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.25" Easing="{StaticResource EaseOut}" /></Transitions>
            </Border.Transitions>
            <ContentPresenter Name="label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center">
              <ContentPresenter.Transitions>
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.25" /></Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.small:pointerover /template/ Border#bg"><Setter Property="Background" Value="#34303a" /></Style>
    <Style Selector="Button.small.accent:pointerover /template/ Border#bg"><Setter Property="Background" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.small.accent:pointerover /template/ ContentPresenter#label"><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="Button#HideButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="Transparent" CornerRadius="7">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.2" /></Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button#HideButton:pointerover /template/ Border#bg"><Setter Property="Background" Value="#2e2a2d" /></Style>
    <Style Selector="Button#HideButton Path">
      <Setter Property="Fill" Value="#6f686c" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Fill" Duration="0:0:0.2" /></Transitions></Setter>
    </Style>
    <Style Selector="Button#HideButton:pointerover Path"><Setter Property="Fill" Value="{DynamicResource AccentBright}" /></Style>
    <Style Selector="TextBlock#HeadingText"><Setter Property="Foreground" Value="#f2eaee" /></Style>
    <Style Selector="TextBlock#HeadingText.failed"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
  </Window.Styles>

  <Border Name="Card" Margin="10" CornerRadius="16" Background="#1e1e20" BorderBrush="#2e2c30" BorderThickness="1"
          BoxShadow="0 10 30 0 #70000000" Opacity="0" RenderTransform="translateY(6px)">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Border.Transitions>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <Button Name="HideButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" ToolTip.Tip="Hide">
        <Viewbox Width="9" Height="9"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Close}" /></Canvas></Viewbox>
      </Button>

      <Border Width="104" Height="104" Margin="0,14,0,0" CornerRadius="14" Background="#121213" BorderBrush="#232225"
              BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
        <Panel>
          <Ellipse Width="96" Height="84" IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#26a64f68" />
                <GradientStop Offset="1" Color="#00000000" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <c:LogoRose Name="Rose" Margin="6" />
        </Panel>
      </Border>

      <TextBlock Grid.Row="1" Name="HeadingText" Classes.failed="{Binding Failed}" Text="{Binding Heading}" Margin="0,14,0,0"
                 HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Grid.Row="2" Name="DetailText" Text="{Binding Detail}" Margin="24,4,24,0" HorizontalAlignment="Center"
                 TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                 FontSize="12" Foreground="#9b9398" />
      <TextBlock Grid.Row="3" Name="GameText" Text="{Binding Game}" IsVisible="{Binding Game, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Margin="24,3,24,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                 FontSize="11.5" Foreground="{DynamicResource Accent}" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding Failed}">
        <Button Name="RetryButton" Classes="small accent" Content="Try again" />
        <Button Name="SettingsButton" Classes="small" Content="Settings" />
      </StackPanel>

      <!-- Progress: the percentage rides on the end of the fill; both glide between updates. -->
      <Grid Grid.Row="5" Margin="14,0,14,14" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding !Failed}">
        <Panel Name="LabelLane" Height="14">
          <TextBlock Name="PercentText" Text="{Binding Percent}" FontSize="10" Foreground="#a99ea4"
                     HorizontalAlignment="Left" RenderTransform="none">
            <TextBlock.Transitions>
              <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="{StaticResource EaseOut}" /></Transitions>
            </TextBlock.Transitions>
          </TextBlock>
          <TextBlock Name="EndText" Text="100%" FontSize="10" Foreground="#5e585c" HorizontalAlignment="Right" />
        </Panel>
        <Panel Grid.Row="1" Name="Track" Height="4" Margin="0,3,0,0">
          <Border CornerRadius="2" Background="#2b2a2d" />
          <Border Name="Fill" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Stretch"
                  RenderTransformOrigin="0%,50%" RenderTransform="scaleX(0)">
            <Border.Transitions>
              <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="{StaticResource EaseOut}" /></Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
        <TextBlock Grid.Row="2" Name="NoteText" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="10.5" Foreground="#7e767b" />
      </Grid>
    </Grid>
  </Border>
</Window>
