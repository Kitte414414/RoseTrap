<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             x:Class="RoseTrap.Views.Pages.SettingsPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <Grid Classes="page-head">
        <StackPanel>
          <TextBlock Classes="h2" Text="Settings" />
          <TextBlock Classes="sub" Text="RoseTrap itself." />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,14,*">
        <Border Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Launching" />
              <TextBlock Classes="sub" Text="What happens when you press Play." />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Open Roblox links with RoseTrap" /><TextBlock Classes="hint" Text="The website's Play button goes through RoseTrap." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding InterceptLinks}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Multiple instances" /><TextBlock Classes="hint" Text="Run several Roblox windows. RoseTrap waits in the background." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding MultiInstance}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Classes="h3" Text="Roblox install" />
                <TextBlock Classes="sub" Text="{Binding InstallSource}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="chip"><TextBlock Text="{Binding InstalledVersion}" /></Border>
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Channel" /><TextBlock Classes="hint" Text="LIVE unless you're testing a beta." /></StackPanel>
              <TextBox Grid.Column="1" Classes="mono" Width="120" Text="{Binding Channel}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Reinstall" /><TextBlock Classes="hint" Text="Fixes a broken install." /></StackPanel>
              <Button Grid.Column="1" Content="Reinstall" Command="{Binding ReinstallCommand}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="RoseTrap folder" /><TextBlock Classes="hint" Text="Settings, Roblox copy, skybox cache." /></StackPanel>
              <Button Grid.Column="1" Name="OpenRootButton" Content="Open folder" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
