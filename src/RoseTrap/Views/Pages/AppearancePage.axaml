<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             x:Class="RoseTrap.Views.Pages.AppearancePage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <Grid Classes="page-head">
        <StackPanel>
          <TextBlock Classes="h2" Text="Appearance" />
          <TextBlock Classes="sub" Text="Make RoseTrap yours." />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,14,*">
        <Border Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Accent colour" />
              <TextBlock Classes="sub" Text="Buttons, switches, icons and highlights." />
            </StackPanel>
            <Border Classes="divider" />
            <StackPanel Name="Swatches" Orientation="Horizontal" Margin="0,14,0,14">
              <RadioButton Classes="swatch" GroupName="accent" Background="#d99aa9" Tag="0" ToolTip.Tip="Rose" />
              <RadioButton Classes="swatch" GroupName="accent" Background="#d9727f" Tag="1" ToolTip.Tip="Crimson" />
              <RadioButton Classes="swatch" GroupName="accent" Background="#b49ad9" Tag="2" ToolTip.Tip="Lilac" />
              <RadioButton Classes="swatch" GroupName="accent" Background="#e0a98a" Tag="3" ToolTip.Tip="Peach" />
              <RadioButton Classes="swatch" GroupName="accent" Background="#8fc9b0" Tag="4" ToolTip.Tip="Mint" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Layout &amp; motion" />
              <TextBlock Classes="sub" Text="Sidebar and page transitions." />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Compact sidebar" /><TextBlock Classes="hint" Text="Icons only; opens while you hover it." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding CompactSidebar}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Page animations" /><TextBlock Classes="hint" Text="Pages fade in when you switch." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Animations}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
