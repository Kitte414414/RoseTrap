<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             x:Class="RoseTrap.Views.Pages.PresetPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <Grid Classes="page-head">
        <StackPanel>
          <TextBlock Classes="h2" Text="Game presets" />
          <TextBlock Classes="sub" Text="Fast flag sets tuned for kinds of games. Your own flags in Fast flags always win." />
        </StackPanel>
      </Grid>

      <Border Classes="panel">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="h3" Text="Pick automatically by game" />
            <TextBlock Classes="sub" Text="When you press Play on roblox.com, RoseTrap recognises the game and applies its preset." />
          </StackPanel>
          <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AutoGamePresets}" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding GamePresetRows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" Margin="-7,-7" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GamePresetRow">
            <Border Classes="panel" Margin="7" Padding="18,16,18,14">
              <DockPanel>
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <ToggleButton Classes="switch sm" IsChecked="{Binding IsAlways}" />
                    <TextBlock Classes="hint" Margin="0" Text="Use for other games" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Copy to Fast flags" Command="{Binding CopyToFlagsCommand}" />
                </Grid>
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                      <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                          <Path Data="{Binding Icon, Converter={x:Static vm:IconConverter.Instance}}" Fill="{DynamicResource AccentBright}" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <TextBlock Classes="h3" Text="{Binding Name}" Margin="0" />
                      <TextBlock Classes="hint" Text="{Binding Games}" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip off" VerticalAlignment="Top"><TextBlock Text="{Binding FlagSummary}" /></Border>
                  </Grid>
                  <TextBlock Classes="sub" Margin="0,10,0,10" Text="{Binding Description}" />
                  <Border Background="{DynamicResource Field}" CornerRadius="8" Padding="10,8" BorderBrush="#2b2a2d" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Flags}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                            <TextBlock Classes="mono" FontSize="10.5" Foreground="#bdb5ba" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5" Foreground="{DynamicResource AccentBright}" Text="{Binding Value}" Margin="8,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
