<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RoseTrap.Controls"
             x:Class="RoseTrap.Views.Pages.WelcomePage">
  <Grid>
    <c:VineFrame />
    <Grid RowDefinitions="*,Auto,10*,Auto,*" Margin="24,18,24,26">
      <TextBlock Grid.Row="1" Text="Select a module" HorizontalAlignment="Center" FontSize="22" FontWeight="Medium"
                 LetterSpacing="0.5" Foreground="#e8dfe2" />
      <Panel Grid.Row="2" MaxWidth="640" MaxHeight="520" Margin="0,4">
        <Ellipse Width="340" Height="300" Opacity="0.9" VerticalAlignment="Center" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Offset="0" Color="#28a64f68" />
              <GradientStop Offset="0.45" Color="#186d3340" />
              <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <c:LogoRose Name="Rose" />
      </Panel>
      <TextBlock Grid.Row="3" Text="Pick a section on the left" HorizontalAlignment="Center" FontSize="12"
                 Foreground="#877b81" />
    </Grid>
  </Grid>
</UserControl>
