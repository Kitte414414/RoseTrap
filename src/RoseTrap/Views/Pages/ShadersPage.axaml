<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             xmlns:c="using:RoseTrap.Controls"
             x:Class="RoseTrap.Views.Pages.ShadersPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,22,24,30" Spacing="14">
      <StackPanel Classes="stagger">
        <TextBlock Classes="eyebrow" Text="07 · SHADERS" />
        <TextBlock Classes="h2" Text="Shaders" />
        <TextBlock Classes="sub" Text="Lighting, sky and post-processing: the look of every game." />
      </StackPanel>
      <Border Classes="divider stagger" />

      <Border Classes="callout stagger" IsVisible="{Binding LegacyIgnored}">
        <TextBlock Classes="hint" Margin="0" Foreground="{DynamicResource AccentBright}"
                   Text="Options marked “legacy” use flags Roblox has ignored since the 2025 allowlist. They're kept for private servers and older clients; turn off “Allowlist only” in FFlags Settings to write them." />
      </Border>

      <Grid ColumnDefinitions="*,14,*">
        <Border Classes="panel stagger">
          <StackPanel>
            <Border Classes="panel-glow" />
            <StackPanel Orientation="Horizontal"><Ellipse Classes="dot" /><TextBlock Classes="h3" Text="Lighting" /></StackPanel>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"><TextBlock Classes="label" Text="Technology" /><TextBlock Classes="hint" Text="Legacy · Future looks best, Voxel is fastest." /></StackPanel>
              <c:Segmented Grid.Column="1" Options="Default,Voxel,ShadowMap,Future" SelectedIndex="{Binding Lighting}" IsEnabled="{Binding NotPotato}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"><TextBlock Classes="label" Text="Shadows" /><TextBlock Classes="hint" Text="Legacy" /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Shadows}" IsEnabled="{Binding NotPotato}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"><TextBlock Classes="label" Text="Post-processing" /><TextBlock Classes="hint" Text="Legacy · bloom, blur, sun rays, colour correction." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding PostProcessing}" IsEnabled="{Binding NotPotato}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"><TextBlock Classes="label" Text="Pause voxel lighting" /><TextBlock Classes="hint" Text="Freezes lighting updates. Big FPS win, lights stop moving." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding PauseVoxelizer}" IsEnabled="{Binding NotPotato}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel stagger">
          <StackPanel>
            <Border Classes="panel-glow" />
            <StackPanel Orientation="Horizontal"><Ellipse Classes="dot" /><TextBlock Classes="h3" Text="Image" /></StackPanel>
            <StackPanel Spacing="7" Margin="0,12,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel><TextBlock Classes="label" Text="Render quality" /><TextBlock Classes="hint" Text="Overrides Roblox's internal quality level (1–21)." /></StackPanel>
                <Border Grid.Column="1" Classes="value"><TextBlock Text="{Binding FrmLabel}" /></Border>
              </Grid>
              <Slider Minimum="0" Maximum="21" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FrmQuality}" IsEnabled="{Binding NotPotato}" />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"><TextBlock Classes="label" Text="Gray sky" /><TextBlock Classes="hint" Text="Replaces skyboxes with flat gray. Calmer and faster." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding GraySky}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
