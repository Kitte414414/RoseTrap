<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             x:Class="RoseTrap.Views.Pages.FlagSettingsPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <Grid Classes="page-head" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h2" Text="Flag settings" />
          <TextBlock Classes="sub" Text="How fast flags are written to Roblox." />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Content="Apply now" Command="{Binding ApplyNowCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,14,*">
        <Border Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Behaviour" />
              <TextBlock Classes="sub" Text="{Binding SkippedSummary}" />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Apply on launch" /><TextBlock Classes="hint" Text="Write flags right before Roblox starts." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ApplyOnLaunch}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Allowlist only" /><TextBlock Classes="hint" Text="Skip flags Roblox ignores and clean them out." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AllowlistOnly}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Also write the global file" /><TextBlock Classes="hint" Text="Flags apply when Roblox starts without RoseTrap too." /></StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding WriteGlobalFile}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Files" />
              <TextBlock Classes="sub" Text="Backups and clean-up." />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Restore original" /><TextBlock Classes="hint" Text="Put the files back how they were before RoseTrap." /></StackPanel>
              <Button Grid.Column="1" Content="Restore" Command="{Binding RestoreBackupCommand}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="Remove RoseTrap flags" /><TextBlock Classes="hint" Text="Flags added by hand are kept." /></StackPanel>
              <Button Grid.Column="1" Classes="danger" Content="Remove" Command="{Binding RemoveAllFlagsCommand}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="label" Text="ClientSettings folder" /><TextBlock Classes="hint" Text="Where ClientAppSettings.json lives." /></StackPanel>
              <Button Grid.Column="1" Name="OpenFolderButton" Content="Open folder" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
