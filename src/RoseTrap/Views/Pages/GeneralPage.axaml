<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoseTrap.ViewModels"
             xmlns:c="using:RoseTrap.Controls"
             x:Class="RoseTrap.Views.Pages.GeneralPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <Grid Classes="page-head" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h2" Text="General" />
          <TextBlock Classes="sub" Text="Frame rate, graphics level and launching." />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary lg" VerticalAlignment="Center" Command="{Binding LaunchCommand}" CommandParameter="{x:Null}"
                IsEnabled="{Binding !IsLaunching}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="12" Height="12" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource AccentInk}" /></Canvas></Viewbox>
            <TextBlock Text="Launch Roblox" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="3*,14,2*">
        <Border Classes="panel">
          <StackPanel>
            <StackPanel Classes="head">
              <TextBlock Classes="h3" Text="Frame rate" />
              <TextBlock Classes="sub" Text="Written to Roblox's own settings, so it works with the fast flag allowlist." />
            </StackPanel>
            <Border Classes="divider" />
            <Grid Classes="slider-row" ColumnDefinitions="120,*,74" Margin="0,6,0,0">
              <TextBlock Text="FPS cap" />
              <Slider Grid.Column="1" Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FpsIndex}" />
              <TextBlock Grid.Column="2" Classes="val" Text="{Binding FpsLabel}" Foreground="{DynamicResource AccentBright}" />
            </Grid>
            <c:TickPanel Margin="128,0,90,8">
              <TextBlock Classes="tick" Text="30" /><TextBlock Classes="tick" Text="60" /><TextBlock Classes="tick" Text="72" />
              <TextBlock Classes="tick" Text="90" /><TextBlock Classes="tick" Text="120" /><TextBlock Classes="tick" Text="144" />
              <TextBlock Classes="tick" Text="165" /><TextBlock Classes="tick" Text="240" /><TextBlock Classes="tick" Text="360" />
              <TextBlock Classes="tick" Text="∞" />
            </c:TickPanel>
            <Border Classes="divider" />
            <Grid Classes="slider-row" ColumnDefinitions="120,*,74" Margin="0,6,0,6">
              <TextBlock Text="Graphics quality" />
              <Slider Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Quality}" IsEnabled="{Binding NotPotato}" />
              <TextBlock Grid.Column="2" Classes="val" Text="{Binding QualityLabel}" Foreground="{DynamicResource AccentBright}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="*,Auto" MinHeight="0">
              <StackPanel Margin="0,0,16,12">
                <TextBlock Classes="h3" Text="Potato mode" />
                <TextBlock Classes="sub" Text="Maximum FPS on weak hardware." />
              </StackPanel>
              <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding Potato}" VerticalAlignment="Top" Margin="0,2,0,0" />
            </Grid>
            <Border Classes="divider" />
            <StackPanel Spacing="8" Margin="0,12,0,10">
              <StackPanel.Styles>
                <Style Selector="TextBlock.check">
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="Foreground" Value="#a69ea3" />
                </Style>
              </StackPanel.Styles>
              <TextBlock Classes="check" Text="•  Graphics quality locked to 1" />
              <TextBlock Classes="check" Text="•  Lowest textures, anti-aliasing off" />
              <TextBlock Classes="check" Text="•  No grass, lowest mesh detail" />
              <TextBlock Classes="check" Text="•  Render quality 1, voxel lighting paused" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="panel">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Classes="h3" Text="Session" />
              <TextBlock Classes="sub" Text="{Binding LaunchStatus}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="chip"><TextBlock Text="{Binding InstallSource}" /></Border>
          </Grid>
          <ProgressBar Classes="launch" Margin="0,0,0,12" Minimum="0" Maximum="1" Value="{Binding LaunchProgress}" IsVisible="{Binding IsLaunching}" />
          <UniformGrid Columns="4" Margin="-4,0,-4,10">
            <Border Classes="stat" Margin="4"><StackPanel><TextBlock Classes="k" Text="ROBLOX" /><TextBlock Classes="v" Text="{Binding InstalledVersion}" /></StackPanel></Border>
            <Border Classes="stat" Margin="4"><StackPanel><TextBlock Classes="k" Text="FLAGS WRITTEN" /><TextBlock Classes="v" Text="{Binding ActiveFlagCount}" /></StackPanel></Border>
            <Border Classes="stat" Margin="4"><StackPanel><TextBlock Classes="k" Text="GRAPHICS PRESET" /><TextBlock Classes="v" Text="{Binding PresetName}" /></StackPanel></Border>
            <Border Classes="stat" Margin="4"><StackPanel><TextBlock Classes="k" Text="FPS CAP" /><TextBlock Classes="v" Text="{Binding FpsLabel}" /></StackPanel></Border>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
